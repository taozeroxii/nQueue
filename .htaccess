Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to secrets, dependency metadata, source, logs, and internal runtime files.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(src|vendor|logs|migrations|python_caller|audio_cache|bin|build|dist)(/|$) - [F,L]
    RewriteRule ^(composer\.(json|lock)|requirements\.txt|config\.json|kiosk_config\.json|scanner_config\.json|.*_migration\.sql|database\.sql)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
